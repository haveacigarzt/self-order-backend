{{define "single-produk"}}
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <link rel="stylesheet" href="/static/css/custom.css">
    <title>Daftar Produk</title>
  </head>
  <body class="min-h-screen">
    <header class="mx-auto max-w-125 min-w-0 bg-white px-5 py-3 border-b border-gray-300">
      <div class="flex items-center">
        <div class="flex-1 flex justify-start">
          <div class="text-sm font-bold px-2 py-1 rounded-lg border border-gray-300 bg-white shadow-sm">
            <i class="fa-solid fa-bars"></i>
          </div>
        </div>
        <div class="flex-3 flex justify-center">
          <img
              src="/static/img/logo-white.png"
              alt="Logo"
              class="w-40 h-12 object-fill"
          />
        </div>
        <div class="flex-1 flex justify-end">
          <div class="text-sm font-bold px-2 py-1 rounded-lg border border-gray-300 bg-white shadow-sm">
            Admin
          </div>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-125 min-w-0 bg-neutral-100 p-5 mb-16">
      <div class="flex flex-col gap-3">
        <div>
          {{.Produk.Nama}}
        </div>

        <div class="grid grid-cols-2 gap-4 mb-5">
          {{ $produk := .Produk }}

          {{ range .Produk.Gambar }}
            <div class="flex flex-col gap-2 border rounded p-3">
              <div class="border rounded">
                {{ if .FilePath }}
                  <img
                    src="/static/uploads/{{ .FilePath }}"
                    alt="Gambar produk"
                    class="aspect-square object-cover rounded-lg w-full old-img"
                  >
                {{ else }}
                  <div class="aspect-square flex items-center justify-center bg-gray-100 rounded-lg preview">
                    <i class="fa-solid fa-image text-3xl text-gray-400"></i>
                  </div>
                {{ end }}
              </div>
              <form
                action="/admin/produk/{{ $produk.ID }}/gambar/{{ .Urutan }}"
                method="POST"
                enctype="multipart/form-data"
              >
                <div class="flex flex-col gap-2">
                  <label
                    class="mb-0 text-sm font-medium"
                    for="gambar_{{ .Urutan }}"
                  >
                    {{ if eq .Urutan 1 }}Thumbnail{{ else }}Gambar {{ .Urutan }}{{ end }}
                  </label>

                  <input
                    class="cursor-pointer border px-2 py-1 rounded bg-gray-300 shadow text-sm w-full"
                    id="gambar_{{ .Urutan }}"
                    name="gambar"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                    required
                  >

                  <button disabled type="submit" class="rounded bg-primary shadow py-1">
                    Simpan
                  </button>
                </div>
              </form>
            </div>
          {{ end }}
        </div>
      </div>
    </main>
    <script>
      document.querySelectorAll('input[name="gambar"]').forEach(input => {
        input.addEventListener('change', function () {
          const file = this.files[0];
          if (!file) return;
          
          const container = this.parentElement.parentElement.parentElement;
          const submitBtn = container.querySelector("button[type='submit']")
          submitBtn.disabled = false;
          
          const oldImg = container.querySelector(".old-img")
          if (oldImg) {
            oldImg.src = URL.createObjectURL(file);
            return;
          }

          const preview = container.querySelector(".preview");
          const img = document.createElement('img');

          img.src = URL.createObjectURL(file);
          img.alt = 'Preview gambar';
          img.className = 'aspect-square object-cover rounded w-full';

          preview.replaceChildren(img);
        });
      });
    </script>
  </body>
</html>
{{ end }}
