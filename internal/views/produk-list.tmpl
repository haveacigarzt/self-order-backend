{{define "produk-list"}}
    <nav
        id="group-nav"
        class="sticky top-0 z-50 -mx-5 bg-neutral-100 px-5 border-b border-gray-300"
    >
        <div
            id="nav-container"
            class="flex w-full min-w-0 gap-1 overflow-x-auto whitespace-nowrap py-2 scrollbar-hide"
        >
            {{ range .Groups }}
                <a
                    href="#grup-{{ .GrupID }}"
                    class="shrink-0 py-2 px-3 text-sm font-bold transition-colors uppercase"
                >
                    {{ .GrupNama }}
                </a>
            {{ end }}
        </div>
    </nav>
    {{ range.Groups }}
        <h2 id="grup-{{ .GrupID }}" class="mb-2 scroll-mt-16 mt-4 uppercase font-bold">{{.GrupNama}}</h2>
        <div class="grid grid-cols-2 gap-4" >
            {{ range.Produk }}
                <div class="flex flex-col gap-2 rounded-lg shadow-md p-3 bg-white produk-card" data-produk="{{ . | toJSON }}">
                    <img src="https://placehold.co/600x400" alt="" class="aspect-square object-cover rounded-lg">
                    <div>
                        <p class="truncate">{{.Nama}}</p>
                        <p data-harga={{ .Harga }}></p>
                    </div>
                </div>
            {{ end }}
        </div>
    {{ end }}
{{ end }}
