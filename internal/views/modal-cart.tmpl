{{ define "modal-cart"}}
<div
    id="cart"
    class="add-menu mx-auto max-w-125 min-w-0">
    <div
        class="flex flex-col gap-3 py-4 max-h-screen overflow-y-auto"
    >
      <div class="flex flex-col gap-3 mb-30">
        <!-- Header -->
        <div class="px-4 flex items-center">
          <button
          id="close_cart"
          type="button"
          class="flex me-3 h-9 w-9 items-center justify-center rounded-full
          bg-neutral-100 text-neutral-600 hover:bg-neutral-200"
          >
            <i class="fa-solid fa-arrow-left"></i>
          </button>
          <h2 class="text-lg font-semibold">Pesanan anda</h2>
        </div>
        <div class="bg-linear-to-t from-white to-gray-200 h-2"></div>
        <div class="px-4">
          <div class="font-bold mb-2">
            Related menu
          </div>
          <div class="flex flex-nowrap gap-2 overflow-x-auto pb-2">
            {{ range.PesananProduk }}
              {{ range.ProdukTerkait }}
                <div class="rounded-lg p-1.5 shadow flex gap-2 max-w-56 shrink-0 edit-button" data-produk="{{ . | toJSON}}">
                  <div class="flex-4">
                    <img src="https://placehold.co/600x400" alt="" class="aspect-square object-cover rounded-lg">
                  </div>
                  <div class="flex-9 flex flex-col justify-between min-w-0">
                    <p class="truncate">{{.Nama}}</p>
                    <div class="flex justify-between">
                      <p data-harga={{ .Harga }}></p>
                      <button class="border border-primary rounded-full size-5 flex items-center justify-center shadow">
                          <i class="fa-solid fa-plus text-xs text-primary"></i>
                      </button>
                    </div>
                  </div>
                </div>
              {{ end }}
            {{ end }}
          </div>
        </div>
        <div class="px-4">
          <div class="flex justify-between mb-3 mt-2">
            <div class="font-bold">Ordered items ({{ len .PesananProduk }})</div>
            <button id="add_item_cart" class="px-2 py-0.5 rounded text-sm shadow bg-primary">+ Add item</button>
          </div>
          <div class="border border-b-0 border-gray-300 rounded">
            {{ range.PesananProduk }}
              <div class="p-3 border-b border-gray-300">
                <div class="flex justify-between gap-3">
                  <div class="truncate">{{ .Produk.Nama }}</div>
                  <button class="px-2 py-0.5 rounded border border-primary text-sm edit-button" data-produk="{{ .Produk | toJSON}}">Edit</button>
                </div>
                <div class="text-sm font-light">
                  &times; {{ .Produk.Qty }}
                </div>
                <div class="text-sm italic font-light">
                  <i class="fa-regular fa-note-sticky"></i>
                  {{ if .Produk.Catatan }}
                      {{ .Produk.Catatan }}
                  {{ else }}
                      No notes yet
                  {{ end }}
                </div>
              </div>
            {{ end }}
          </div>
        </div>
      </div>

      <div class="fixed bottom-0 inset-x-0 z-50">
        <div class="flex justify-between gap-3 p-4 bg-gray-100 border-y border-gray-300">
            <div>
              <div class="-mb-1">Total</div>
              <div class="text-2xl">{{.Total}}</div>
            </div>
            <div class="my-auto">
              <button id="simpan_button"  class="bg-primary rounded p-3 shadow">Pembayaran</button>
            </div>
        </div>
        <div class="bg-linear-to-t from-white to-gray-200 h-3"></div>
      </div>
    </div>
</div>
{{end}}