{{ define "modal-cart"}}
<div
    id="modal_cart"
    class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black/30 p-4 backdrop-blur-xs">
    <div
        class="relative w-full max-w-md max-h-[95vh] overflow-y-auto
        rounded-lg bg-white pt-3 shadow-lg flex flex-col gap-3"
    >
      <div class="px-4 flex flex-col gap-3">
        <!-- Header -->
        <div class=" flex items-center justify-between">
            <h2 class="text-lg font-semibold">Pesanan anda</h2>

            <button
                id="button_close_modal_cart"
                type="button"
                class="flex h-9 w-9 items-center justify-center rounded-full
                    bg-neutral-100 text-neutral-600 hover:bg-neutral-200"
            >
                ✕
            </button>
        </div>
        <div>
          <div class="font-bold">
            Related menu
          </div>
          <div>

          </div>
        </div>
        <div>
          <div class="flex justify-between mb-3">
            <div class="font-bold">Ordered items ({{ len .PesananProduk }})</div>
            <button class="px-2 py-0.5 rounded text-sm shadow bg-primary">+ Add item</button>
          </div>
          <div class="border border-b-0 border-gray-300 rounded">
            {{ range.PesananProduk }}
              <div class="p-3 border-b border-gray-300">
                <div class="flex justify-between gap-3">
                  <div class="truncate">{{ .Nama }}</div>
                  <button class="px-2 py-0.5 rounded border border-primary text-sm">Edit</button>
                </div>
                <div class="text-sm font-light">
                  &times; {{ .Qty }}
                </div>
                <div class="text-sm italic font-light">
                  <i class="fa-regular fa-note-sticky"></i>
                  {{ if .Catatan }}
                      {{ .Catatan }}
                  {{ else }}
                      No notes yet
                  {{ end }}
                </div>
              </div>
            {{ end }}
          </div>
        </div>
      </div>

      <div>
        <div class="flex justify-between gap-3 p-4 bg-gray-100 border-y border-gray-300">
            <div>
              <div class="-mb-1">Total</div>
              <div class="text-2xl">{{.Total}}</div>
            </div>
            <div class="my-auto">
              <button id="simpan_button"  class="bg-primary rounded p-3 shadow">Pembayaran</button>
            </div>
        </div>
        <div class="bg-linear-to-t from-white to-gray-200 h-5"></div>
      </div>
    </div>
</div>
{{end}}