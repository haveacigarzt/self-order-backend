{{define "footer"}}
<div class="flex justify-between px-4 py-2 rounded border border-gray-400 grow">
  <div>Total: </div>
  <div>{{.Total}}</div>
</div>
<button class="px-4 py-2 rounded bg-primary" id="cart_button">
  <i class="fa-solid fa-cart-shopping relative">
      <span class="badge badge-1" id="total_quantity">
        {{.TotalQty}}
      </span>
  </i>
  Cart
</button>
{{end}}