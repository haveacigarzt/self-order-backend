{{ define "modal-produk"}}
<div
    id="modal_produk"
    class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black/30 p-4 backdrop-blur-xs">
    <div
        id="modal_content"
        class="relative w-full max-w-md max-h-[95vh] overflow-y-auto
        rounded-lg bg-white pt-3 shadow-lg flex flex-col gap-3"
    >
      <div class="px-4 flex flex-col gap-3">
        <!-- Header -->
        <div class=" flex items-center justify-between">
            <h2 class="text-lg font-semibold">Atur pesanan</h2>

            <button
                id="button_close_modal"
                type="button"
                class="flex h-9 w-9 items-center justify-center rounded-full
                    bg-neutral-100 text-neutral-600 hover:bg-neutral-200"
            >
                ✕
            </button>
        </div>

        <div class="shadow rounded-lg">
          <!-- Product Image -->
          <div class="relative">
              <img
                  id="modal_produk_image"
                  src="https://placehold.co/200x200"
                  alt="Product image"
                  class="aspect-video w-full rounded-lg object-cover"
              />

              <button
                  type="button"
                  class="absolute left-2 top-2 z-10 rounded-md
                        bg-white/80 px-2 py-1 text-sm shadow"
              >
                  <i class="fa-solid fa-expand"></i>
              </button>
          </div>

          <!-- Product Information -->
          <div class="p-3">
              <h3
                  id="modal_produk_nama"
                  class="text-xl font-semibold"
              ></h3>

              <p
                  id="modal_produk_deskripsi"
                  class="mt-2 text-sm text-neutral-500"
              ></p>

              <p
                  id="modal_produk_harga"
                  class="mt-3 text-lg font-bold text-primary"
              ></p>
          </div>
        </div>

        <div>
          <p class="mb-1">Notes (Opsional)</p>
          <textarea id="notes_input" class="resize-none w-full border border-primary rounded p-2 text-sm placeholder:italic" placeholder="Type your message here." maxlength="255" ></textarea>
        </div>
      </div>

      <div>
        <div class="flex justify-between gap-3 p-4 bg-gray-100 border-y border-gray-300">
            <button id="hapus_button" class="bg-white border-primary rounded px-2 text-sm shadow">Hapus</button>
            <div class="flex justify-center items-center gap-8">
              <button class="w-9 h-9 rounded-full border border-gray-300" id="button_decrement">
                <i class="fa-solid fa-minus"></i>
              </button>
              <h4 class="scroll-m-20 text-xl font-semibold tracking-tight" id="modal_produk_quantity"></h4>
              <button class="w-9 h-9 rounded-full border border-gray-300" id="button_increment">
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>
            <button id="simpan_button"  class="bg-primary rounded px-2 text-sm shadow">Simpan</button>
        </div>
        <div class="bg-linear-to-t from-white to-gray-200 h-5"></div>
      </div>
    </div>
</div>
{{end}}