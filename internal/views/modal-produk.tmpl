{{ define "modal-produk"}}
<div
    id="add-menu" class="add-menu mx-auto max-w-125 min-w-0"
    >
    <form
        id="add_menu_form"
        class="flex flex-col gap-3 py-4 max-h-screen overflow-y-scroll"
        action="/meja/{{.NomorMeja}}" method="post"
    >
        <input type="hidden" name="produk_id" id="produk_id_input">
        <div class="flex flex-col gap-3 mb-25">
            <!-- Header -->
            <div class="px-4 flex items-center justify-between">
                <h2 class="text-lg font-semibold">Atur pesanan</h2>

                <button
                    id="close_page"
                    type="button"
                    class="flex h-9 w-9 items-center justify-center rounded-full
                        bg-neutral-100 text-neutral-600 hover:bg-neutral-200"
                >
                    ✕
                </button>
            </div>
            <div class="bg-linear-to-t from-white to-gray-200 h-2"></div>
            <div class="mx-4 shadow rounded-lg">
            <!-- Product Image -->
            <div class="relative">
                <img
                    id="modal_produk_image"
                    src=""
                    alt=""
                    class="aspect-video w-full rounded-lg object-cover"
                />
                <button
                    type="button"
                    class="absolute left-2 top-2 z-10 rounded-md
                            bg-white/80 px-2 py-1 text-sm shadow"
                            id="button_max_image"
                >
                    <i class="fa-solid fa-expand"></i>
                </button>
            </div>

            <!-- Product Information -->
            <div class="p-3">
                <h3
                    id="modal_produk_nama"
                    class="text-xl font-semibold"
                ></h3>

                <p
                    id="modal_produk_deskripsi"
                    class="mt-2 text-sm text-neutral-500"
                ></p>

                <p
                    id="modal_produk_harga"
                    class="mt-3 text-lg font-bold text-primary"
                ></p>
            </div>
            </div>
            <div class="px-4">
                <p class="mb-1">Notes (Opsional)</p>
                <textarea name="catatan" id="notes_input" class="resize-none w-full border border-primary rounded p-2 text-sm placeholder:italic" placeholder="Type your message here." maxlength="255" ></textarea>
            </div>
        </div>

        <div class="fixed bottom-0 inset-x-0 z-50">
            <div class="flex justify-between gap-3 p-4 bg-gray-100 border-y border-gray-300">
                <button type="button" id="hapus_button" class="bg-white border-primary rounded px-2 text-sm shadow" data-meja={{.NomorMeja}}>Hapus</button>
                <div class="flex justify-center items-center gap-8">
                <button type="button" class="w-9 h-9 rounded-full border border-gray-300" id="button_decrement">
                    <i class="fa-solid fa-minus"></i>
                </button>
                <h4 class="scroll-m-20 text-xl font-semibold tracking-tight" id="modal_produk_quantity"></h4>
                <input type="hidden" name="quantity" id="quantity_input">
                <button type="button" class="w-9 h-9 rounded-full border border-gray-300" id="button_increment">
                    <i class="fa-solid fa-plus"></i>
                </button>
                </div>
                <button disabled type="submit" id="simpan_button" class="bg-primary rounded px-2 text-sm shadow">Simpan</button>
            </div>
            <div class="bg-linear-to-t from-white to-gray-200 h-3"></div>
        </div>
    </form>
    <div id="modal_image_carousel" class="flex items-center">
        <button
            id="close_image_carousel"
            type="button"
            class="absolute top-5 right-5 flex h-9 w-9 items-center justify-center rounded-full
                bg-neutral-100 text-neutral-600 hover:bg-neutral-200"
        >
            ✕
        </button>
        <div class="carousel-container">
            <button id="prev" class="carousel-button">
                <i class="fa-solid fa-arrow-left"></i>
            </button>

            <div class="carousel">
                <div class="carousel-track" id="carousel-track">
                </div>
            </div>

            <button id="next" class="carousel-button">
                <i class="fa-solid fa-arrow-right"></i>
            </button>

            <div class="carousel-markers" id="carousel-markers"></div>
        </div>
    </div>
</div>
{{end}}