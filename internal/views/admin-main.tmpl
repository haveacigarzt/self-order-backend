{{define "admin-main"}}
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <link rel="stylesheet" href="/static/css/custom.css">
    <title>Daftar Produk</title>
  </head>
  <body class="min-h-screen">
    <header class="mx-auto max-w-125 min-w-0 bg-white px-5 py-3 border-b border-gray-300">
      <div class="flex items-center">
        <div class="flex-1 flex justify-start">
          <div class="text-sm font-bold px-2 py-1 rounded-lg border border-gray-300 bg-white shadow-sm">
            <i class="fa-solid fa-bars"></i>
          </div>
        </div>
        <div class="flex-3 flex justify-center">
          <img
              src="/static/img/logo-white.png"
              alt="Logo"
              class="w-40 h-12 object-fill"
          />
        </div>
        <div class="flex-1 flex justify-end">
          <div class="text-sm font-bold px-2 py-1 rounded-lg border border-gray-300 bg-white shadow-sm">
            Admin
          </div>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-125 min-w-0 bg-neutral-100 px-5 pb-5">
      <div id="produk-list">
        {{template "produk-list-admin" .}}
      </div>
    </main>
  </body>
  <script src="/static/js/admin.js">
  </script>
</html>
{{ end }}
